#!/usr/bin/env bash

source $(dirname $0)/includes.sh

MERGE=false
REBASE=true
UPSTREAM=upstream
MASTER=master
DEBUG=false

function checkExitCode() {
    RC=$1
    shift
    MSG="$*"
    if [ $RC != 0 ] ; then
        if [ "$MSG" != "" ] ; then
            error "$MSG"
        fi
        exit $RC
    fi
}

if git branch | grep -c " main$" &> /dev/null  ; then
    MASTER=main
fi

while getopts "b:du:rm" OPTION; do
    case $OPTION in
        b) MASTER=$OPTARG ;;
        d) DEBUG=true ;;
        u) UPSTREAM=$OPTARG ;;
        r) REBASE=true ;
           MERGE=false ;;
        m) MERGE=true ;
           REBASE=false ;;
        *) usage ;;
    esac
done
shift $((OPTIND -1))

CUR_BRANCH=$( git branch --show-current )

debug "Determining worktree root if needed"
CURRENT_DIR=$(pwd)
WORKTREE_ROOT=$(git worktree list | head -1 | cut -f 1 -d ' ')

debug "Fetching all remotes..."
cd $WORKTREE_ROOT
git fetch --all -p
checkExitCode $?

pause

debug "Switching to $MASTER"
git checkout "$MASTER"
checkExitCode $?

pause

debug "Rebasing"
git rebase "$UPSTREAM/$MASTER"
checkExitCode $?

pause

debug "Pushing to origin"
git push
checkExitCode $?

pause

if [ "$CUR_BRANCH" != "$MASTER" ] ; then
    debug "Checking out working branch $CUR_BRANCH"
    cd $CURRENT_DIR
    git checkout "$CUR_BRANCH"
    checkExitCode $?

    pause
    
    if [ "$MERGE" == "true" ] ; then
        debug "Merging $MASTER into $CUR_BRANCH"
        git merge "$MASTER"
    fi
    
    if [ "$REBASE" == "true" ] ; then
        debug "Rebasing $CUR_BRANCH on $MASTER"
        git rebase "$MASTER"
    fi
fi

# For good measure
cd $CURRENT_DIR
